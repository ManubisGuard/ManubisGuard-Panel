#!/usr/bin/env bash
set -Eeuo pipefail

INSTALLER="/opt/manubisguard-panel/install-manubisguard.sh"
PROJECT_DIR="/opt/manubisguard-panel"
BACKUP_DIR="/opt/manubisguard/backup"
DATABASE_BACKUP_DIR="$BACKUP_DIR/database"
FULL_BACKUP_DIR="$BACKUP_DIR/full"
BOOTSTRAP_URL="https://raw.githubusercontent.com/ManubisGuard/ManubisGuard-Panel/feature/amnezia-wg/install-manubisguard.sh"
CLI_URL="https://raw.githubusercontent.com/ManubisGuard/ManubisGuard-Panel/feature/amnezia-wg/manubis"

show_help() {
  cat <<'HELP'
==============================
           Manubis Help
==============================
Usage:
  manubis [command]

Commands:
  up              – Start services
  down            – Stop services
  restart         – Restart services
  status          – Show status
  logs            – Show logs
  cli             – ManubisGuard CLI
  tui             – ManubisGuard TUI
  install         – Install ManubisGuard
  update          – Update to latest version
  uninstall       – Uninstall ManubisGuard
  install-script  – Install/update manubis script
  install-node    – Install ManubisGuard node
  backup          – Create a full-system backup
  backup-db       – Create a database-only backup
  migrate         – Explicit cross-panel migration/apply
  backup-service  – Configure automated database backups
  restore         – Restore database from backup file
  edit            – Edit docker-compose.yml
  edit-env        – Edit environment file
  version-script  – Show script version and commit
  completion      – Install bash completion
  help            – Show this help

Directories:
  App directory: /opt/manubisguard-panel
  Data directory: /var/lib/manubisguard
==============================
HELP
}

need_project() {
  [ -d "$PROJECT_DIR" ] || { echo "ManubisGuard is not installed. Run: manubis install" >&2; exit 1; }
}

install_from_installer() {
  local tmp
  tmp="$(mktemp)"
  curl -fsSL "$BOOTSTRAP_URL" -o "$tmp"
  exec bash "$tmp" "$@"
}

restore_command() {
  need_project
  if [ "${1:-}" = "--check" ] || [ "${1:-}" = "--stage-test" ]; then
    [ "$#" -eq 2 ] || { echo "Usage: manubis restore --check|--stage-test /opt/manubisguard/backup/full/<archive.zip>" >&2; exit 2; }
    [ -x /usr/local/sbin/manubisguard-native-restore.py ] || { echo "Native restore validator/test runner is not installed; no changes made." >&2; exit 3; }
    exec /usr/local/sbin/manubisguard-native-restore.py "$1" "$2"
  fi
  if [ "$#" -eq 1 ]; then
    [ -x /usr/local/sbin/manubisguard-native-restore.py ] || { echo "Native full restore engine is not installed yet; no changes made. Use 'manubis migrate <archive.zip> --apply' only for an intentional cross-panel migration." >&2; exit 3; }
    exec /usr/local/sbin/manubisguard-native-restore.py --apply "$1"
  fi
  [ "$#" -eq 0 ] || { echo "Usage: manubis restore [--check] [/opt/manubisguard/backup/full/<archive.zip>]" >&2; exit 2; }
  local -a backups=()
  local item choice selected
  mkdir -p "$FULL_BACKUP_DIR"
  while IFS= read -r -d '' item; do backups+=("$item"); done < <(
    find "$FULL_BACKUP_DIR" -maxdepth 1 -type f -name 'manubisguard-full-*.zip' -print0 2>/dev/null | sort -z -V
  )
  if [ "${#backups[@]}" -eq 0 ]; then
    echo "No native full backups found in $FULL_BACKUP_DIR" >&2
    exit 1
  fi
  echo "Available native ManubisGuard full backups:"
  local i=1
  for item in "${backups[@]}"; do
    printf '  %d) %s (%s)\n' "$i" "$(basename "$item")" "$(du -h "$item" | cut -f1)"
    i=$((i + 1))
  done
  printf 'Select backup [1-%d]: ' "${#backups[@]}"
  read -r choice
  [[ "$choice" =~ ^[0-9]+$ ]] || { echo "Invalid backup selection." >&2; exit 2; }
  (( choice >= 1 && choice <= ${#backups[@]} )) || { echo "Invalid backup selection." >&2; exit 2; }
  selected="${backups[$((choice - 1))]}"
  [ -x /usr/local/sbin/manubisguard-native-restore.py ] || { echo "Native full restore engine is not installed yet; selected archive: $selected; no changes made. Use 'manubis migrate <archive.zip> --apply' only for an intentional cross-panel migration." >&2; exit 3; }
  exec /usr/local/sbin/manubisguard-native-restore.py --apply "$selected"
}

migrate_command() {
  need_project
  [ "$#" -ge 1 ] || { echo "Usage: manubis migrate /path/to/source-archive.zip [--apply]" >&2; exit 2; }
  local archive="$1"; shift
  [ "$#" -le 1 ] && { [ "$#" -eq 0 ] || [ "$1" = "--apply" ]; } || { echo "Usage: manubis migrate /path/to/source-archive.zip [--apply]" >&2; exit 2; }
  exec /usr/local/bin/manubisguard-migrate "$archive" "$@"
}

case "${1:-help}" in
  up|start)
    need_project; cd "$PROJECT_DIR"; exec docker compose up -d
    ;;
  down|stop)
    need_project; cd "$PROJECT_DIR"; exec docker compose stop
    ;;
  restart)
    need_project; cd "$PROJECT_DIR"; exec docker compose restart
    ;;
  status)
    need_project; cd "$PROJECT_DIR"; exec docker compose ps
    ;;
  logs)
    need_project; cd "$PROJECT_DIR"; shift
    exec docker compose logs --tail="${MANUBISGUARD_LOG_TAIL:-100}" -f manubisguard "$@"
    ;;
  cli)
    need_project; shift
    exec docker compose exec -it manubisguard /usr/bin/manubisguard-cli "$@"
    ;;
  tui)
    need_project; shift
    exec docker compose exec -it manubisguard /usr/bin/manubis-tui "$@"
    ;;
  install)
    shift
    install_from_installer install "$@"
    ;;
  update)
    install_from_installer install --yes --override
    ;;
  uninstall)
    need_project
    if [ "${MANUBISGUARD_YES:-false}" != true ]; then
      printf 'This removes the ManubisGuard application but preserves /var/lib/manubisguard. Continue? [y/N] '
      read -r answer
      case "$answer" in y|Y|yes|YES) ;; *) echo "Cancelled."; exit 0 ;; esac
    fi
    cd "$PROJECT_DIR"
    docker compose down --remove-orphans || true
    systemctl disable --now manubisguard-restore-agent.service 2>/dev/null || true
    rm -f /etc/systemd/system/manubisguard-restore-agent.service /usr/local/bin/manubisguard-restore-agent
    systemctl daemon-reload
    rm -rf "$PROJECT_DIR"
    rm -f /usr/local/bin/manubis
    echo "ManubisGuard application removed. Data preserved in /var/lib/manubisguard."
    ;;
  install-script)
    tmp="$(mktemp)"
    curl -fsSL "$CLI_URL" -o "$tmp"
    install -m 0755 "$tmp" /usr/local/bin/manubis
    rm -f "$tmp"
    echo "manubis script installed."
    ;;
  install-node)
    need_project; shift
    exec bash "$PROJECT_DIR/install-node.sh" "$@"
    ;;
  backup)
    need_project
    [ "$#" -eq 1 ] || { echo "Usage: manubis backup" >&2; exit 2; }
    if [ -x /usr/local/sbin/manubisguard-full-backup.py ]; then
      exec /usr/local/sbin/manubisguard-full-backup.py
    fi
    exec python3 "$PROJECT_DIR/scripts/manubisguard-full-backup.py"
    ;;
  backup-db)
    need_project; cd "$PROJECT_DIR"
    [ "$#" -le 2 ] || { echo "Usage: manubis backup-db [output-dir]" >&2; exit 2; }
    shift
    exec bash scripts/backup-db.sh "${1:-$DATABASE_BACKUP_DIR}"
    ;;
  backup-service)
    need_project
    printf 'Backup interval (minutes: 5/15/30/60/120/1440) [30]: '
    read -r interval
    interval="${interval:-30}"
    case "$interval" in 5|15|30|60|120|1440) ;; *) echo "Unsupported interval. Use 5, 15, 30, 60, 120 or 1440." >&2; exit 2 ;; esac
    printf 'Telegram Bot Token (leave empty to disable Telegram): '
    read -r -s telegram_token
    printf '\n'
    telegram_chat_id=""
    if [ -n "$telegram_token" ]; then
      printf 'Telegram Chat ID: '
      read -r telegram_chat_id
      [ -n "$telegram_chat_id" ] || { echo "Telegram Chat ID is required when Telegram is enabled." >&2; exit 2; }
    fi
    printf 'Retention count [7]: '
    read -r retention
    retention="${retention:-7}"
    [[ "$retention" =~ ^[1-9][0-9]*$ ]] || { echo "Invalid retention count." >&2; exit 2; }
    payload=$(python3 - "$interval" "$retention" "$telegram_token" "$telegram_chat_id" <<'PY'
import json, sys
interval=int(sys.argv[1]); retention=int(sys.argv[2]); token=sys.argv[3]; chat=sys.argv[4]
print(json.dumps({"frequency":"interval","interval_minutes":interval,"retention_count":retention,"telegram_bot_token":token,"telegram_chat_id":chat}))
PY
)
    printf '%s\n' "$payload" | docker compose -f "$PROJECT_DIR/docker-compose.yml" exec -T manubisguard python -m app.backup_cli
    echo "Schedule: every ${interval} minute(s)"
    echo "Retention: ${retention}"
    echo "Telegram: $([ -n "$telegram_token" ] && echo enabled || echo disabled)"
    ;;
  restore)
    shift
    restore_command "$@"
    ;;
  migrate)
    shift
    migrate_command "$@"
    ;;
  edit)
    need_project
    editor="${EDITOR:-nano}"
    command -v "$editor" >/dev/null 2>&1 || { echo "Editor not found: $editor" >&2; exit 1; }
    exec "$editor" "$PROJECT_DIR/docker-compose.yml"
    ;;
  edit-env)
    need_project
    editor="${EDITOR:-nano}"
    command -v "$editor" >/dev/null 2>&1 || { echo "Editor not found: $editor" >&2; exit 1; }
    exec "$editor" "$PROJECT_DIR/.env"
    ;;
  version-script)
    echo "Manubis CLI"
    if [ -f "$PROJECT_DIR/install-manubisguard.sh" ]; then
      sha="$(git -C "$PROJECT_DIR" rev-parse HEAD 2>/dev/null || true)"
      branch="$(git -C "$PROJECT_DIR" branch --show-current 2>/dev/null || true)"
      echo "Branch: ${branch:-unknown}"
      echo "Commit: ${sha:-unknown}"
    fi
    echo "Script: /usr/local/bin/manubis"
    ;;
  completion)
    install -d /etc/bash_completion.d
    cat > /etc/bash_completion.d/manubis <<'COMP'
_manubis_completion() {
  local cur="${COMP_WORDS[COMP_CWORD]}"
  local commands="up down restart status logs cli tui install update uninstall install-script install-node backup backup-db backup-service restore migrate edit edit-env version-script completion help"
  COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
}
complete -F _manubis_completion manubis
COMP
    echo "Bash completion installed. Start a new shell or run: source /etc/bash_completion.d/manubis"
    ;;
  help|-h|--help)
    show_help
    ;;
  *)
    echo "Unknown command: $1" >&2
    show_help >&2
    exit 2
    ;;
esac
